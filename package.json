{
  "name": "pipesonata",
  "private": true,
  "version": "0.1.0",
  "description": "Turn CI workflow timing, failure, and concurrency into an actionable visual score.",
  "type": "module",
  "license": "MIT",
  "author": "KanadeK <1207048080@qq.com>",
  "homepage": "https://kanadek.github.io/pipesonata/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KanadeK/pipesonata.git"
  },
  "bugs": {
    "url": "https://github.com/KanadeK/pipesonata/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "benchmark": "node scripts/benchmark.mjs",
    "demo": "npm run build && node scripts/demo.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "audit:dependencies": "npm audit --audit-level=high --registry=https://registry.npmjs.org",
    "verify": "node scripts/verify.mjs",
    "package": "npm run build && node scripts/demo.mjs --skip-doc-screenshot && node scripts/package_release.mjs",
    "release-check": "npm run verify && npm run package && node scripts/release_check.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@tonaljs/tonal": "4.10.0",
    "d3": "7.9.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/d3": "7.4.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
